POSTGRES_DB=profi24
POSTGRES_USER=profi24
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
DB_POOL_MAX=10
WEB_PORT=5173
BACKUP_RETENTION_DAYS=14
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_TOKEN_TTL=12h
AUTH_FAILURE_LIMIT=10
AUTH_FAILURE_WINDOW_MINUTES=10
AUTH_LOCK_MINUTES=15

# Secure server-to-server intake from profi24.kz. Never expose this value in browser JavaScript.
WEBSITE_INTAKE_SECRET=replace-with-a-separate-long-random-secret-at-least-32-characters

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
